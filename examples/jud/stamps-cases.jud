# Forty generated document pages for the stamps rubric: thirty with one
# round ink stamp, labelled with its bounding box, and ten without, so the
# Noul has both outcomes. Drawn by scripts/gen-document-pages.py from one
# seed, which is why the labels are exact. Each case names its page once,
# in `assets`, by a path relative to this file; the reference is what the
# state carries.
apiVersion: jud/v1
kind: Cases
metadata:
  name: stamps-cases
  minor: 4
  description: Forty generated document pages, labelled by the generator that drew them.
spec:
  rubric: stamps
  cases:
    - id: page-00
      state: {page: page-00}
      assets:
        page-00: {type: image, path: images/page-00.png}
      expect:
        stamp_present: true
        stamp: {box: {top: 0.8154, bottom: 0.8769, left: 0.4117, right: 0.4917}}
      tags: [stamp]
    - id: page-01
      state: {page: page-01}
      assets:
        page-01: {type: image, path: images/page-01.png}
