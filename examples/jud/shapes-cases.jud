# Forty synthetic images for the shapes rubric: thirty with one filled
# circle, labelled with its box, and ten without, so the Noul has both
# outcomes. Each case names its image once, in `assets`, by a path relative
# to this file; the reference is what the state carries.
apiVersion: jud/v1
kind: Cases
metadata:
  name: shapes-cases
  minor: 4
  description: Forty generated images, labelled by the generator that drew them.
spec:
  rubric: shapes
  cases:
    - id: shape-00
      state: {image: shape-00}
      assets:
        shape-00: {type: image, path: images/shape-00.png}
      expect:
        circle_present: true
        circle: {box: {top: 0.6062, bottom: 0.7875, left: 0.7, right: 0.8812}}
      tags: [circle]
    - id: shape-01
      state: {image: shape-01}
      assets:
        shape-01: {type: image, path: images/shape-01.png}
