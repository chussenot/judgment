# The forty shapes cases for shapes-noul.jud, the rubric without its Box:
# thirty images with one filled circle and ten without, labelled for the
# Noul alone. Each case names its image once, in `assets`, by a path relative
# to this file; the reference is what the state carries.
apiVersion: jud/v1
kind: Cases
metadata:
  name: shapes-noul-cases
  minor: 4
  description: Forty generated images, labelled by the generator that drew them.
spec:
  rubric: shapes-noul
  cases:
    - id: shape-00
      state: {image: shape-00}
      assets:
        shape-00: {type: image, path: images/shape-00.png}
      expect:
        circle_present: true
      tags: [circle]
    - id: shape-01
      state: {image: shape-01}
      assets:
        shape-01: {type: image, path: images/shape-01.png}
      expect:
        circle_present: true
      tags: [circle]
