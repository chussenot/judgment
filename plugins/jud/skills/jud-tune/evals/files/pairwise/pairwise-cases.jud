apiVersion: jud/v1
kind: Cases
metadata:
  name: pairwise-cases
  minor: 4
  description: Twelve LLMBar Natural pairs, six with the better answer first.
spec:
  rubric: pairwise-judge
  cases:
    - id: llmbar-natural-001
      state: {instruction: "Complete a brief story given the following first sentence. [MALE] was a weatherman."}
      options:
        better:
          a: "He learned his weather report. He prepared for his forecast. He expected the forecast would be wrong. Yet when the forecast report came back positive!"
          b: "He would always mistreat it every day. He eats a lot of food. He is glad he had a cow."
      expect: {better: a}
    - id: llmbar-natural-005
      state: {instruction: "Complete a brief story given the following first sentence.\n\nOne day my wife and I were on the bench in front of our building."}
      options:
        better:
          a: "My wife felt very down so I started to play a game. She ended up making a lot of friends on the bench. She had a big smile on her face to show her appreciation. I had fun that day."
          b: "We were expecting a refund. the next week, the store had an iPad. The next week, the other kids were transferred to the store. We were all the best we had ever washed the car."
      expect: {better: a}
    - id: llmbar-natural-010
      state: {instruction: "Complete a brief story given the following first sentence. we sat down to watch the news with dinner."}
      options:
        better:
          a: "They had caught a big storm about tonight. The news says the storm had made it a mud puddle. We decided to do some things about it. We cleaned the puddle up afterward."
          b: "Our girlfriend was not allowed to go to the party. She told us she was not to be upset. She was very upset. She joined the club."
      expect: {better: a}
    - id: llmbar-natural-020
      state: {instruction: "Generate two rhymes for the following word. Moon"}
      options:
        better:
          a: "Soon, Loon"
          b: "Clone, June, Nore, Tune"
      expect: {better: a}
    - id: llmbar-natural-021
      state: {instruction: "Given the following input statement, provide the type of sentiment in the statement and the extent of sentiment in terms of sentiment scores. This restaurant has the best service I've ever seen. You can design the score scale by yourself."}
      options:
        better:
          a: "This statement has a sentiment score of 9 / 10"
          b: "Positive sentiment, sentiment score: 9.5 out of 10"
      expect: {better: b}
    - id: llmbar-natural-024
      state: {instruction: "Generate a new sentence combining two of the following given sentences, with a correct relationship between them. My daughter was jumping up and down. She was excited to go out to the park."}
      options:
        better:
          a: "My daughter was jumping up and down, because she was excited to go out to the park."
          b: "My daughter was jumping up and down, but she was excited to go out to the park."
      expect: {better: a}
    - id: llmbar-natural-027
      state: {instruction: "Rewrite this sentence in a more concise way: \"Cloud computing is an emerging technology which allows businesses to store and manage data and applications on servers hosted on the internet.\""}
      options:
        better:
          a: "Cloud hosting provides on-demand access to data and applications from any location."
          b: "Cloud computing lets businesses store and manage data and applications on internet-hosted servers."
      expect: {better: b}
    - id: llmbar-natural-028
      state: {instruction: "Convert the following date from the Gregorian calendar to the Julian calendar: November 29, 2020"}
      options:
        better:
          a: "By the year 2020, November 29, 2020 (Julian date) is 13 days behind the Gregorian calendar."
          b: "The Julian calendar date of November 29, 2020 (Gregorian calendar) is November 16, 2020."
      expect: {better: b}
    - id: llmbar-natural-029
      state: {instruction: "Create a complete function that will generate an array of random numbers from 1 to 100"}
      options:
        better:
          a: "for x in range(1, 101):\n    data.append(x)"
          b: "def generate_array(n): \n    array = [] \n    while len(array) != n: \n        num = random.randint(1, 101) \n        array.append(num) \n    return array \n\nprint(generate_array(100))"
      expect: {better: b}
    - id: llmbar-natural-031
      state: {instruction: "Give a helpful response to the following statement: My bag is lost."}
      options:
        better:
          a: "I'm sorry to hear that. Have you tried searching for it or notified authorities like the police?"
          b: "I'm sorry to hear about your loss."
      expect: {better: a}
    - id: llmbar-natural-033
      state: {instruction: "Given a base number and a power, calculate the result.\n\nBase:5   Power:3"}
      options:
        better:
          a: "5 x 5 x 5 = 625"
          b: "125"
      expect: {better: b}
    - id: llmbar-natural-038
      state: {instruction: "Modify the given function to accept and use two parameters. def greet_customer():\n    return \"Welcome!\""}
      options:
        better:
          a: "def greet_customer(name, customer):\n    return \"Welcome!\" + name + \"!\""
          b: "def greet_customer(name, surname):\n    return \"Welcome!\" + name + \" \" + surname + \"!\""
      expect: {better: b}
