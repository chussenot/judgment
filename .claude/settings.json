{
  "enabledPlugins": {
    "typesafe@typesafe-ai": true
  },
  "extraKnownMarketplaces": {
    "typesafe-ai": {
      "source": {
        "repo": "typesafe-ai/skills",
        "source": "github"
      }
    }
  },
  "hooks": {
    "PostToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/rustfmt-on-edit.sh",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      },
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/llms-on-docs-edit.sh",
            "timeout": 15,
            "type": "command"
          }
        ],
        "matcher": "Edit|Write"
      }
    ],
    "PreToolUse": [
      {
        "hooks": [
          {
            "command": "\"$CLAUDE_PROJECT_DIR\"/.claude/hooks/guard-bash.sh",
            "timeout": 5,
            "type": "command"
          }
        ],
        "matcher": "Bash"
      }
    ],
    "SessionStart": [
      {
        "hooks": [
          {
            "command": "bd prime --hook-json",
            "type": "command"
          }
        ],
        "matcher": ""
      }
    ]
  },
  "permissions": {
    "allow": [
      "Bash(cargo fmt:*)",
      "Bash(cargo clippy:*)",
      "Bash(cargo test:*)",
      "Bash(cargo doc:*)",
      "Bash(cargo build:*)",
      "Bash(cargo check:*)",
      "Bash(cargo package --list:*)",
      "Bash(cargo run -p judgment --example:*)",
      "Bash(cargo run --example:*)",
      "Bash(mise run:*)",
      "Bash(mise tasks:*)",
      "Bash(mise ls:*)",
      "Bash(prek run:*)",
      "Bash(bd ready:*)",
      "Bash(bd show:*)",
      "Bash(bd list:*)",
      "Bash(bd search:*)",
      "Bash(bd create:*)",
      "Bash(bd update:*)",
      "Bash(bd close:*)",
      "Bash(bd dep:*)",
      "Bash(bd remember:*)",
      "Bash(bd memories:*)",
      "Bash(bd prime:*)",
      "Bash(bd export:*)",
      "Bash(scripts/check-frontmatter.sh:*)",
      "Bash(scripts/gen-llms-txt.sh:*)",
      "Bash(git status:*)",
      "Bash(git diff:*)",
      "Bash(git log:*)"
    ],
    "deny": [
      "Read(./.env)",
      "Read(./.env.local)"
    ]
  }
}
