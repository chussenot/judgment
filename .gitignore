/target
**/*.rs.bk

# Local secrets (loaded by mise from .env; never committed)
.env
.env.*
!.env.example

# A Python environment for the System One shim (tools/systemone) or laya-serve
.venv/
__pycache__/

# mise
.mise.local.toml
mise.local.toml

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*
