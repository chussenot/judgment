/target
**/*.rs.bk

# Local secrets (loaded by mise from .env; never committed)
.env
.env.*
!.env.example

# A Python environment for the System One shim (tools/systemone) or laya-serve
.venv/
__pycache__/

# mise
.mise.local.toml
mise.local.toml

# Beads / Dolt files (added by bd init)
.dolt/
*.db
.beads-credential-key
.beads/proxieddb/
*.gate.lock*

# The container image's build context, filled by scripts/image-context.sh
# from the release tarballs or a local build (Dockerfile).
/bin/
/image/
*.snap.new
mutants.out
mutants.out.old

# Everything pact or an agent writes under .pact/ is local runtime state,
# EXCEPT the files below, which are history or graph and belong in git.
.pact/*
!.pact/events.jsonl
!.pact/messages.jsonl
!.pact/plan.json
