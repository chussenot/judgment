{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chussenot/judgment/schemas/jud/cases.schema.json",
  "title": ".jud Cases",
  "description": "Labelled states a rubric is graded on (docs/reference/jud-format.md). metadata takes name, description, labels and annotations; spec.rubric names the rubric by its metadata.name or by fingerprint.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "apiVersion": true,
    "kind": {
      "const": "Cases"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata",
      "not": {
        "anyOf": [
          {
            "required": [
              "version"
            ]
          }
        ]
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "rubric": {
          "type": "string",
          "description": "The rubric the labels are for, by name or by fingerprint."
        },
        "cases": {
          "type": "array",
          "minItems": 1,
          "items": {
            "type": "object",
            "properties": {
              "id": {
                "$ref": "common.schema.json#/$defs/name"
              },
              "state": {
                "description": "Any JSON; an array is a conversation, one element per turn."
              },
              "expect": {
                "type": "object",
                "description": "By question id: true or false for a Noul (or {from_turn} over a conversation), an option key for a Choice, a level index or a level's text for a Score.",
                "additionalProperties": {
                  "oneOf": [
                    {
                      "type": "boolean"
                    },
                    {
                      "type": "integer",
                      "minimum": 0
                    },
                    {
                      "type": "string"
                    },
                    {
                      "type": "object",
                      "properties": {
                        "from_turn": {
                          "type": [
                            "integer",
                            "null"
                          ],
                          "minimum": 0
                        }
                      },
                      "required": [
                        "from_turn"
                      ],
                      "additionalProperties": false
                    }
                  ]
                }
              },
              "tags": {
                "type": "array",
                "items": {
                  "type": "string"
                }
              },
              "note": {
                "type": "string"
              },
              "options": {
                "type": "object",
                "description": "options supplied for this case's request, by question id, then option key to description.",
                "additionalProperties": {
                  "type": "object",
                  "propertyNames": {
                    "minLength": 1
                  },
                  "additionalProperties": {
                    "type": [
                      "string",
                      "object",
                      "array",
                      "null"
                    ]
                  }
                }
              }
            },
            "required": [
              "state"
            ],
            "additionalProperties": false
          }
        }
      },
      "required": [
        "cases"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
