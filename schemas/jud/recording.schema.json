{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chussenot/judgment/schemas/jud/recording.schema.json",
  "title": ".jud Recording",
  "description": "One model response to one request, with the request's fingerprint, the server and the time (docs/reference/jud-format.md). metadata.name is the case it answers (or the request hash); metadata takes name, labels and annotations.",
  "type": "object",
  "allOf": [
    {
      "$ref": "common.schema.json#/$defs/envelope"
    }
  ],
  "properties": {
    "apiVersion": true,
    "kind": {
      "const": "Recording"
    },
    "metadata": {
      "$ref": "common.schema.json#/$defs/metadata",
      "not": {
        "anyOf": [
          {
            "required": [
              "version"
            ]
          },
          {
            "required": [
              "description"
            ]
          }
        ]
      }
    },
    "spec": {
      "type": "object",
      "properties": {
        "response": {
          "type": "object",
          "properties": {
            "model": {
              "type": "string"
            },
            "answers": {
              "type": "object",
              "additionalProperties": {
                "type": "object",
                "properties": {
                  "type": {
                    "type": "string"
                  }
                },
                "required": [
                  "type"
                ]
              }
            },
            "usage": {
              "type": "object",
              "properties": {
                "input_tokens": {
                  "type": "integer",
                  "minimum": 0
                },
                "output_tokens": {
                  "type": "integer",
                  "minimum": 0
                }
              }
            },
            "request_id": {
              "type": "string"
            }
          },
          "required": [
            "model",
            "answers"
          ]
        },
        "elapsed_ms": {
          "type": "integer",
          "minimum": 0
        },
        "request_hash": {
          "type": "string",
          "description": "This crate's own 16-hex-digit request hash, when a Recorder made the file."
        },
        "fingerprint": {
          "$ref": "common.schema.json#/$defs/fingerprint"
        },
        "server": {
          "type": "string"
        },
        "recorded_at": {
          "$ref": "common.schema.json#/$defs/rfc3339"
        },
        "rubric": {
          "type": "string",
          "description": "The rubric the questions came from, by name or by fingerprint."
        }
      },
      "required": [
        "response",
        "elapsed_ms"
      ],
      "additionalProperties": false
    }
  },
  "required": [
    "apiVersion",
    "kind",
    "metadata",
    "spec"
  ],
  "additionalProperties": false
}
