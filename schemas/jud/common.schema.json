{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chussenot/judgment/schemas/jud/common.schema.json",
  "title": ".jud common definitions",
  "description": "Definitions shared by the three document kinds of the .jud format (docs/reference/jud-format.md): the envelope of a manifest, the metadata, names, fingerprints, questions, assets and box edges.",
  "$defs": {
    "envelope": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "enum": [
            "jud/v1",
            "jud/v1.3"
          ],
          "description": "The stable v1 line, whose minor is metadata.minor; `jud/v1.3` is the earlier spelling of minor 3, read as it stands and never written. Any other value is refused by name."
        },
        "kind": {
          "type": "string",
          "enum": [
            "Rubric",
            "Cases",
            "Recording"
          ]
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "spec": {
          "type": "object"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "additionalProperties": false,
      "allOf": [
        {
          "if": {
            "properties": {
              "apiVersion": {
                "const": "jud/v1"
              }
            }
          },
          "then": {
            "properties": {
              "metadata": {
                "required": [
                  "minor"
                ]
              }
            }
          },
          "else": {
            "properties": {
              "metadata": {
                "not": {
                  "required": [
                    "minor"
                  ]
                }
              }
            }
          }
        }
      ]
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "A name: letters, digits, `.`, `_` and `-`, starting with a letter or a digit; never a path. Every metadata.name and every case id."
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of canonical JSON (RFC 8785), lowercase hex."
    },
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "instructions": {
      "description": "What to decide: a string, an object or an array, or null when the criteria carry the question. On the wire it is sent as null, never left out.",
      "type": [
        "string",
        "object",
        "array",
        "null"
      ]
    },
    "description": {
      "description": "A rubric description: a string, an object, or null for none.",
      "type": [
        "string",
        "object",
        "array",
        "null"
      ]
    },
    "question": {
      "description": "One question, exactly as the wire sends it. A part_when needs instructions that are an object.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "noul"
            },
            "instructions": {
              "$ref": "#/$defs/instructions"
            },
            "criteria": {
              "type": "object",
              "properties": {
                "true": {
                  "$ref": "#/$defs/description"
                },
                "false": {
                  "$ref": "#/$defs/description"
                }
              },
              "additionalProperties": false
            },
            "when": {
              "$ref": "#/$defs/statePath",
              "description": "ask the question only when this state path is present."
            },
            "part_when": {
              "type": "object",
              "description": "instruction part name to the state path that must be present for the part to be sent.",
              "additionalProperties": {
                "$ref": "#/$defs/statePath"
              }
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "choice"
            },
            "instructions": {
              "$ref": "#/$defs/instructions"
            },
            "criteria": {
              "type": "object",
              "maxProperties": 255,
              "propertyNames": {
                "minLength": 1
              },
              "additionalProperties": {
                "$ref": "#/$defs/description"
              }
            },
            "when": {
              "$ref": "#/$defs/statePath",
              "description": "ask the question only when this state path is present."
            },
            "part_when": {
              "type": "object",
              "description": "instruction part name to the state path that must be present for the part to be sent.",
              "additionalProperties": {
                "$ref": "#/$defs/statePath"
              }
            },
            "options_from": {
              "const": "request",
              "description": "the options are supplied per request, before the static ones in criteria."
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "if": {
            "required": [
              "options_from"
            ]
          },
          "then": {
            "properties": {
              "criteria": {
                "minProperties": 0
              }
            }
          },
          "else": {
            "required": [
              "criteria"
            ],
            "properties": {
              "criteria": {
                "minProperties": 2
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "box"
            },
            "instructions": {
              "description": "What to locate, and in which image; a string, an object or an array, never null: a Box has no criteria to carry the question.",
              "type": [
                "string",
                "object",
                "array"
              ]
            },
            "when": {
              "$ref": "#/$defs/statePath",
              "description": "ask the question only when this state path is present."
            },
            "part_when": {
              "type": "object",
              "description": "instruction part name to the state path that must be present for the part to be sent.",
              "additionalProperties": {
                "$ref": "#/$defs/statePath"
              }
            }
          },
          "required": [
            "type",
            "instructions"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "score"
            },
            "instructions": {
              "$ref": "#/$defs/instructions"
            },
            "criteria": {
              "type": "array",
              "minItems": 2,
              "maxItems": 10,
              "items": {
                "type": [
                  "string",
                  "object",
                  "array"
                ]
              }
            },
            "when": {
              "$ref": "#/$defs/statePath",
              "description": "ask the question only when this state path is present."
            },
            "part_when": {
              "type": "object",
              "description": "instruction part name to the state path that must be present for the part to be sent.",
              "additionalProperties": {
                "$ref": "#/$defs/statePath"
              }
            }
          },
          "required": [
            "type",
            "criteria"
          ],
          "additionalProperties": false
        }
      ],
      "if": {
        "required": [
          "part_when"
        ]
      },
      "then": {
        "required": [
          "instructions"
        ],
        "properties": {
          "instructions": {
            "type": "object"
          }
        }
      }
    },
    "asset": {
      "type": "object",
      "description": "An image the document refers to by the key it sits under: a file by a path relative to the document, or the bytes inline with their format (docs/reference/jud-format.md, Assets).",
      "properties": {
        "type": {
          "const": "image"
        },
        "path": {
          "type": "string",
          "minLength": 1,
          "pattern": "^(?![/\\\\])(?![A-Za-z]:)(?!.*(^|[/\\\\])\\.\\.([/\\\\]|$)).*$",
          "description": "Relative to the document's directory, never absolute (a leading slash or backslash, or a drive such as C:) and never leaving it (a .. segment on either separator)."
        },
        "format": {
          "enum": [
            "png",
            "jpg",
            "jpeg"
          ]
        },
        "data_base64": {
          "type": "string",
          "minLength": 1,
          "pattern": "^[A-Za-z0-9+/]+={0,2}$"
        }
      },
      "additionalProperties": false,
      "oneOf": [
        {
          "required": [
            "path"
          ],
          "not": {
            "required": [
              "data_base64"
            ]
          }
        },
        {
          "required": [
            "data_base64",
            "format"
          ],
          "not": {
            "required": [
              "path"
            ]
          }
        }
      ]
    },
    "assets": {
      "type": "object",
      "description": "Reference to asset. A reference is text a state or a question carries where the image belongs.",
      "propertyNames": {
        "minLength": 1,
        "maxLength": 1024,
        "pattern": "\\S",
        "description": "A reference is not blank: at least one character that is not whitespace."
      },
      "additionalProperties": {
        "$ref": "#/$defs/asset"
      }
    },
    "boxEdges": {
      "type": "object",
      "description": "The four edges of a box, as fractions of the image from its top-left corner.",
      "properties": {
        "top": {
          "$ref": "#/$defs/unit"
        },
        "bottom": {
          "$ref": "#/$defs/unit"
        },
        "left": {
          "$ref": "#/$defs/unit"
        },
        "right": {
          "$ref": "#/$defs/unit"
        }
      },
      "required": [
        "top",
        "bottom",
        "left",
        "right"
      ],
      "additionalProperties": false
    },
    "statePath": {
      "type": "string",
      "pattern": "^[^.\\s](?:[^.]*[^.\\s])?(?:\\.[^.\\s](?:[^.]*[^.\\s])?)*$",
      "description": "A state path: dot-separated object keys, a number indexing an array. Present when it leads to a value that is not null, \"\", [] or {}."
    },
    "metadata": {
      "type": "object",
      "description": "What names the document and what a tool keeps beside the format. Which optional fields a kind takes, its own schema says.",
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "minor": {
          "type": "integer",
          "minimum": 0,
          "maximum": 4,
          "description": "The minor of jud/v1 the document needs: required under apiVersion jud/v1, refused under the earlier spelling. A reader reads every minor up to its own and refuses a higher one by number. An integer as the reader sees it: `4.0` is a float to a YAML or JSON reader and is refused, though JSON Schema's integer takes it."
        },
        "version": {
          "type": [
            "string",
            "number"
          ],
          "description": "A Rubric's edition, free-form; a number is read as its text."
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/stringMap"
        },
        "annotations": {
          "$ref": "#/$defs/stringMap"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
