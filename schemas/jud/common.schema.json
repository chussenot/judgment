{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chussenot/judgment/schemas/jud/common.schema.json",
  "title": ".jud common definitions",
  "description": "Definitions shared by the three document kinds of the .jud format, version 1 (docs/jud.md).",
  "$defs": {
    "envelope": {
      "type": "object",
      "properties": {
        "jud": { "const": 1, "description": "The format version." },
        "kind": { "type": "string", "enum": ["rubric", "cases", "recording"] }
      },
      "required": ["jud", "kind"]
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of canonical JSON (RFC 8785), lowercase hex."
    },
    "unit": { "type": "number", "minimum": 0, "maximum": 1 },
    "rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "instructions": {
      "description": "What to decide: a string, an object or an array, or null when the criteria carry the question. On the wire it is sent as null, never left out.",
      "type": ["string", "object", "array", "null"]
    },
    "description": {
      "description": "A rubric description: a string, an object, or null for none.",
      "type": ["string", "object", "array", "null"]
    },
    "question": {
      "description": "One question, exactly as the wire sends it.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": { "const": "noul" },
            "instructions": { "$ref": "#/$defs/instructions" },
            "criteria": {
              "type": "object",
              "properties": {
                "true": { "$ref": "#/$defs/description" },
                "false": { "$ref": "#/$defs/description" }
              },
              "additionalProperties": false
            }
          },
          "required": ["type"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "choice" },
            "instructions": { "$ref": "#/$defs/instructions" },
            "criteria": {
              "type": "object",
              "minProperties": 2,
              "maxProperties": 255,
              "propertyNames": { "minLength": 1 },
              "additionalProperties": { "$ref": "#/$defs/description" }
            }
          },
          "required": ["type", "criteria"],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": { "const": "score" },
            "instructions": { "$ref": "#/$defs/instructions" },
            "criteria": {
              "type": "array",
              "minItems": 2,
              "maxItems": 10,
              "items": { "type": ["string", "object", "array"] }
            }
          },
          "required": ["type", "criteria"],
          "additionalProperties": false
        }
      ]
    }
  }
}
