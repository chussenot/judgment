{
  "$schema": "https://json-schema.org/draft/2020-12/schema",
  "$id": "https://github.com/chussenot/judgment/schemas/jud/common.schema.json",
  "title": ".jud common definitions",
  "description": "Definitions shared by the three document kinds of the .jud format (docs/jud.md): the envelope of a manifest, the metadata, names, fingerprints and questions.",
  "$defs": {
    "envelope": {
      "type": "object",
      "properties": {
        "apiVersion": {
          "const": "jud/v1.3",
          "description": "The one version a reader reads; any other value is refused by name."
        },
        "kind": {
          "type": "string",
          "enum": [
            "Rubric",
            "Cases",
            "Recording"
          ]
        },
        "metadata": {
          "$ref": "#/$defs/metadata"
        },
        "spec": {
          "type": "object"
        }
      },
      "required": [
        "apiVersion",
        "kind",
        "metadata",
        "spec"
      ],
      "additionalProperties": false
    },
    "name": {
      "type": "string",
      "pattern": "^[A-Za-z0-9][A-Za-z0-9._-]*$",
      "description": "A name: letters, digits, `.`, `_` and `-`, starting with a letter or a digit; never a path. Every metadata.name and every case id."
    },
    "fingerprint": {
      "type": "string",
      "pattern": "^sha256:[0-9a-f]{64}$",
      "description": "SHA-256 of canonical JSON (RFC 8785), lowercase hex."
    },
    "unit": {
      "type": "number",
      "minimum": 0,
      "maximum": 1
    },
    "rfc3339": {
      "type": "string",
      "pattern": "^[0-9]{4}-[0-9]{2}-[0-9]{2}T[0-9]{2}:[0-9]{2}:[0-9]{2}(\\.[0-9]+)?(Z|[+-][0-9]{2}:[0-9]{2})$"
    },
    "instructions": {
      "description": "What to decide: a string, an object or an array, or null when the criteria carry the question. On the wire it is sent as null, never left out.",
      "type": [
        "string",
        "object",
        "array",
        "null"
      ]
    },
    "description": {
      "description": "A rubric description: a string, an object, or null for none.",
      "type": [
        "string",
        "object",
        "array",
        "null"
      ]
    },
    "question": {
      "description": "One question, exactly as the wire sends it.",
      "oneOf": [
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "noul"
            },
            "instructions": {
              "$ref": "#/$defs/instructions"
            },
            "criteria": {
              "type": "object",
              "properties": {
                "true": {
                  "$ref": "#/$defs/description"
                },
                "false": {
                  "$ref": "#/$defs/description"
                }
              },
              "additionalProperties": false
            },
            "when": {
              "$ref": "#/$defs/statePath",
              "description": "ask the question only when this state path is present."
            },
            "part_when": {
              "type": "object",
              "description": "instruction part name to the state path that must be present for the part to be sent.",
              "additionalProperties": {
                "$ref": "#/$defs/statePath"
              }
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "choice"
            },
            "instructions": {
              "$ref": "#/$defs/instructions"
            },
            "criteria": {
              "type": "object",
              "maxProperties": 255,
              "propertyNames": {
                "minLength": 1
              },
              "additionalProperties": {
                "$ref": "#/$defs/description"
              }
            },
            "when": {
              "$ref": "#/$defs/statePath",
              "description": "ask the question only when this state path is present."
            },
            "part_when": {
              "type": "object",
              "description": "instruction part name to the state path that must be present for the part to be sent.",
              "additionalProperties": {
                "$ref": "#/$defs/statePath"
              }
            },
            "options_from": {
              "const": "request",
              "description": "the options are supplied per request, before the static ones in criteria."
            }
          },
          "required": [
            "type"
          ],
          "additionalProperties": false,
          "if": {
            "required": [
              "options_from"
            ]
          },
          "then": {
            "properties": {
              "criteria": {
                "minProperties": 0
              }
            }
          },
          "else": {
            "required": [
              "criteria"
            ],
            "properties": {
              "criteria": {
                "minProperties": 2
              }
            }
          }
        },
        {
          "type": "object",
          "properties": {
            "type": {
              "const": "score"
            },
            "instructions": {
              "$ref": "#/$defs/instructions"
            },
            "criteria": {
              "type": "array",
              "minItems": 2,
              "maxItems": 10,
              "items": {
                "type": [
                  "string",
                  "object",
                  "array"
                ]
              }
            },
            "when": {
              "$ref": "#/$defs/statePath",
              "description": "ask the question only when this state path is present."
            },
            "part_when": {
              "type": "object",
              "description": "instruction part name to the state path that must be present for the part to be sent.",
              "additionalProperties": {
                "$ref": "#/$defs/statePath"
              }
            }
          },
          "required": [
            "type",
            "criteria"
          ],
          "additionalProperties": false
        }
      ]
    },
    "statePath": {
      "type": "string",
      "pattern": "^[^.\\s](?:[^.]*[^.\\s])?(?:\\.[^.\\s](?:[^.]*[^.\\s])?)*$",
      "description": "A state path: dot-separated object keys, a number indexing an array. Present when it leads to a value that is not null, \"\", [] or {}."
    },
    "metadata": {
      "type": "object",
      "description": "What names the document and what a tool keeps beside the format. Which optional fields a kind takes, its own schema says.",
      "properties": {
        "name": {
          "$ref": "#/$defs/name"
        },
        "version": {
          "type": [
            "string",
            "number"
          ],
          "description": "A Rubric's edition, free-form; a number is read as its text."
        },
        "description": {
          "type": "string"
        },
        "labels": {
          "$ref": "#/$defs/stringMap"
        },
        "annotations": {
          "$ref": "#/$defs/stringMap"
        }
      },
      "required": [
        "name"
      ],
      "additionalProperties": false
    },
    "stringMap": {
      "type": "object",
      "additionalProperties": {
        "type": "string"
      }
    }
  }
}
